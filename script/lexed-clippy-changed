#!/usr/bin/env bash

# Clippy the workspace crates that changed relative to origin/main. This is the
# pre-push tier; the whole-workspace clippy is CI's job. Dev profile on purpose
# — script/clippy's --release --all-features is far too slow for a hook.
#
# Usage: script/lexed-clippy-changed [--list]
#   --list: print the detected crates and exit.

set -euo pipefail

cd "$(dirname "$0")/.."

# Past this many crates a scoped run stops being meaningfully cheaper than the
# workspace run CI already does, so defer rather than stall the push.
MAX_CRATES=15

list_only=false
if [ "${1:-}" = "--list" ]; then
    list_only=true
elif [ $# -gt 0 ]; then
    echo "usage: $0 [--list]" >&2
    exit 1
fi

crates=()
while read -r crate; do
    crates+=("$crate")
done < <(script/lexed-changed-crates)

if [ "$list_only" = true ]; then
    if [ ${#crates[@]} -gt 0 ]; then
        printf '%s\n' "${crates[@]}"
    fi
    exit 0
fi

if [ ${#crates[@]} -eq 0 ]; then
    echo "lexed-clippy-changed: no crates changed against origin/main; nothing to do."
    exit 0
fi

if [ ${#crates[@]} -gt "$MAX_CRATES" ]; then
    echo "lexed-clippy-changed: ${#crates[@]} crates changed, over the cap of $MAX_CRATES."
    echo "Skipping the scoped run; CI's workspace clippy covers this push."
    exit 0
fi

packages=()
for crate in "${crates[@]}"; do
    packages+=(-p "$crate")
done

echo "lexed-clippy-changed: ${crates[*]}"
cargo clippy "${packages[@]}" --all-targets -- -D warnings
