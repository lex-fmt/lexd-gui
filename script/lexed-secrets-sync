#!/usr/bin/env bash

# Lexed secrets sync: push the two secrets GitHub Actions needs to hold itself
# from Doppler into the GitHub repository (docs/lexed/ci-plan.md §4).
#
# This table is the single source of truth for which GitHub secret carries
# which Doppler value. Re-running is idempotent — `gh secret set` overwrites.
#
#   GitHub secret     Doppler key (github/prd)   Contents
#   ---------------   ------------------------   -----------------------------------------
#   DOPPLER_TOKEN     LEXD_GUI_DOPPLER_TOKEN     read-only service token for lexd-gui-ci/prd
#   SCCACHE_GCS_KEY   SCCACHE_GCS_KEY            GCS service-account JSON for sccache
#
# The Apple signing material is deliberately NOT here. `lexed_release.yml`
# fetches it at run time from Doppler project `lexd-gui-ci`, config `prd`, which
# holds nothing but these nine and reaches the real values through cross-project
# secret references into `github/prd`:
#
#   CI-facing name                  references
#   -----------------------------   -------------------------------------
#   MACOS_CERTIFICATE               github.prd.APPLE_CERTIFICATE_P12_BASE64
#   MACOS_CERTIFICATE_PASSWORD      github.prd.APPLE_CERTIFICATE_PASSWORD
#   APPLE_SIGNING_IDENTITY          github.prd.APPLE_SIGNING_IDENTITY
#   APPLE_NOTARIZATION_KEY_BASE64   github.prd.ASC_API_KEY_BASE64
#   APPLE_NOTARIZATION_KEY_ID       github.prd.ASC_API_KEY_ID
#   APPLE_NOTARIZATION_ISSUER_ID    github.prd.ASC_API_ISSUER_ID
#   APPLE_NOTARIZATION_APPLE_ID     github.prd.APPLE_ID
#   APPLE_NOTARIZATION_PASSWORD     github.prd.APPLE_APP_SPECIFIC_PASSWORD
#   APPLE_NOTARIZATION_TEAM_ID      github.prd.APPLE_TEAM_ID
#
# A separate project rather than a branch config under `github`: branch configs
# inherit their environment's root config, so a token scoped to one would have
# read every production secret in `github/prd`.
#
# Doppler has two exact-duplicate pairs (verified by digest, 2026-08-14):
# APPLE_CERTIFICATE == APPLE_CERTIFICATE_P12_BASE64, and APPLE_PASSWORD ==
# APPLE_APP_SPECIFIC_PASSWORD. The explicitly named key of each pair is the one
# referenced above; the aliases are ignored.
#
# Usage: script/lexed-secrets-sync [--dry-run] [--repo <owner/repo>]

set -euo pipefail

DOPPLER_PROJECT="github"
DOPPLER_CONFIG="prd"
REPO="lex-fmt/lexd-gui"
DRY_RUN=false

SECRETS=(
    "DOPPLER_TOKEN LEXD_GUI_DOPPLER_TOKEN"
    "SCCACHE_GCS_KEY SCCACHE_GCS_KEY"
)

while [ $# -gt 0 ]; do
    case "$1" in
        --dry-run)
            DRY_RUN=true
            shift
            ;;
        --repo)
            if [ $# -lt 2 ]; then
                echo "error: --repo needs an <owner/repo> argument." >&2
                exit 2
            fi
            REPO="$2"
            shift 2
            ;;
        *)
            echo "error: unknown argument '$1'." >&2
            echo "Usage: script/lexed-secrets-sync [--dry-run] [--repo <owner/repo>]" >&2
            exit 2
            ;;
    esac
done

if ! command -v doppler >/dev/null 2>&1; then
    echo "error: doppler not found. Install it with: brew install dopplerhq/cli/doppler" >&2
    exit 2
fi

if ! command -v gh >/dev/null 2>&1; then
    echo "error: gh not found. Install it with: brew install gh" >&2
    exit 2
fi

if [ "$DRY_RUN" = true ]; then
    echo "Dry run: would sync ${#SECRETS[@]} secrets to $REPO"
else
    echo "Syncing ${#SECRETS[@]} secrets to $REPO"
fi
echo "  from doppler project '$DOPPLER_PROJECT', config '$DOPPLER_CONFIG'"
echo

set_count=0
fail_count=0

for entry in "${SECRETS[@]}"; do
    name="${entry%% *}"
    key="${entry##* }"

    if [ "$DRY_RUN" = true ]; then
        echo "would set $name <- $key"
        set_count=$((set_count + 1))
        continue
    fi

    # The `printf x` sentinel survives command substitution's unconditional
    # strip of trailing newlines, so the value stays byte-exact and only the one
    # newline `--plain` appends is removed. A value pushed with that newline
    # still attached breaks every consumer that compares it (an app-specific
    # password, a team id) rather than decodes it.
    if ! value="$(doppler secrets get "$key" --plain \
        --project "$DOPPLER_PROJECT" --config "$DOPPLER_CONFIG" && printf x)"; then
        echo "FAIL $name: doppler could not read $key"
        fail_count=$((fail_count + 1))
        continue
    fi
    value="${value%x}"
    value="${value%$'\n'}"

    # Value on stdin, never argv — argv is world-readable via ps.
    if printf '%s' "$value" | gh secret set "$name" --repo "$REPO" >/dev/null 2>&1; then
        echo "set $name"
        set_count=$((set_count + 1))
    else
        echo "FAIL $name: gh secret set failed (check gh auth and repo access)"
        fail_count=$((fail_count + 1))
    fi
    unset value
done

echo
if [ "$DRY_RUN" = true ]; then
    echo "$set_count would be set, $fail_count failed"
else
    echo "$set_count set, $fail_count failed"
fi

if [ "$fail_count" -gt 0 ]; then
    exit 1
fi
