#!/usr/bin/env bash

# Run the tests of the changed lex_* crates. Pre-push tier: only fork-owned
# crates, because the upstream suite is CI-sized and would make the hook
# something developers route around with --no-verify.
#
# Usage: script/lexed-test-changed [--list]
#   --list: print the detected crates and exit.

set -euo pipefail

cd "$(dirname "$0")/.."

list_only=false
if [ "${1:-}" = "--list" ]; then
    list_only=true
elif [ $# -gt 0 ]; then
    echo "usage: $0 [--list]" >&2
    exit 1
fi

crates=()
while read -r crate; do
    crates+=("$crate")
done < <(script/lexed-changed-crates lex_)

if [ "$list_only" = true ]; then
    if [ ${#crates[@]} -gt 0 ]; then
        printf '%s\n' "${crates[@]}"
    fi
    exit 0
fi

if [ ${#crates[@]} -eq 0 ]; then
    echo "lexed-test-changed: no lex_* crates changed against origin/main; nothing to do."
    exit 0
fi

packages=()
for crate in "${crates[@]}"; do
    packages+=(-p "$crate")
done

echo "lexed-test-changed: ${crates[*]}"
# Through `script/lexed-test` so the hook applies the same exclusions and
# budgets CI does; a bare `cargo nextest run` here would answer differently.
script/lexed-test "${packages[@]}"
