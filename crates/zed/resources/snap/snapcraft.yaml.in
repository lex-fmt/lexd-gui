name: lexed
title: Lexed
base: core24
version: "$RELEASE_VERSION"
summary: A fast editor for Lex
description: |
  Lexed is an editor for Lex, a plain-text markup language for ideas. It is built
  in Rust with a GPU-accelerated renderer, and stays out of the way while you write.
grade: stable
confinement: classic
compression: lzo
website: https://lex.ing/
source-code: https://github.com/lex-fmt/lexezed
issues: https://github.com/lex-fmt/lexezed/issues
contact: https://github.com/lex-fmt/lexezed/issues

parts:
  lexed:
    plugin: dump
    source: "https://github.com/lex-fmt/lexezed/releases/download/v$RELEASE_VERSION/lexed-linux-x86_64.tar.gz"

    organize:
      # These renames seem to not be necessary, but it's tidier.
      bin: usr/bin
      libexec: usr/libexec

    stage-packages:
      - libasound2t64
      # snapcraft has a lint that this is unused, but without it Lexed exits with
      # "Missing Vulkan entry points: LibraryLoadFailure" in wgpu.
      - libvulkan1
      # snapcraft has a lint that this is unused, but without it Lexed exits with
      # "NoWaylandLib" when run with Wayland.
      - libwayland-client0
      - libxcb1
      - libxkbcommon-x11-0
      - libxkbcommon0

    build-attributes:
      - enable-patchelf

    prime:
      # Omit unneeded files from the tarball
      - -lib
      - -licenses.md
      - -share

      # Omit unneeded files from stage-packages
      - -etc
      - -usr/share/doc
      - -usr/share/lintian
      - -usr/share/man

apps:
  lexed:
    command: usr/bin/lexed
    common-id: ing.lex.Lexed
    environment:
      ZED_BUNDLE_TYPE: snap
