<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
    <id>$APP_ID</id>
    <metadata_license>MIT</metadata_license>
    <project_license>Apache-2.0 and GPL-3.0-or-later</project_license>

    <name>$APP_NAME</name>
    <summary>A fast editor for Lex, a plain-text markup language for ideas</summary>
    <developer id="ing.lex">
        <name translate="no">The Lex project</name>
    </developer>
    <description>
        <p>
            Writing starts with a tool that stays out of your way. Lexed pairs the structure of Lex, a plain-text markup language for ideas, with an editor fast enough to keep up with your thinking.
        </p>
        <p>Features:</p>
        <ul>
            <li>Performance: Efficiently uses every CPU core and your GPU for instant startup, quick file loading, and responsive keystrokes.</li>
            <li>Language-aware: Maintains a syntax tree for precise highlighting, and auto-indent, with LSP support for autocompletion and refactoring.</li>
            <li>Lex support: Syntax highlighting, diagnostics, and spellcheck for .lex documents with no configuration.</li>
            <li>Preview: A live preview pane that renders Lex and scroll-syncs with the editor.</li>
        </ul>
    </description>

    <launchable type="desktop-id">$APP_ID.desktop</launchable>

    <branding>
        <color type="primary" scheme_preference="light">$BRANDING_LIGHT</color>
        <color type="primary" scheme_preference="dark">$BRANDING_DARK</color>
    </branding>

    <content_rating type="oars-1.1" />

    <url type="homepage">https://lex.ing</url>
    <url type="bugtracker">https://github.com/lex-fmt/lexezed/issues</url>
    <url type="vcs-browser">https://github.com/lex-fmt/lexezed</url>
    <url type="contribute">https://github.com/lex-fmt/lexezed/blob/main/CONTRIBUTING.md</url>

    <supports>
        <internet>offline-only</internet>
    </supports>
    <recommends>
        <control>pointing</control>
        <control>keyboard</control>
        <display_length compare="ge">768</display_length>
    </recommends>

    <screenshots>
        <screenshot type="default">
            <caption>Lexed with a Lex document open, showing the outline and the preview pane</caption>
            <image>https://lex.ing/img/flatpak/flatpak-1.png</image>
        </screenshot>
        <screenshot>
            <caption>Lexed with a project open and the file tree in the left sidebar</caption>
            <image>https://lex.ing/img/flatpak/flatpak-2.png</image>
        </screenshot>
        <screenshot>
            <caption>Spellcheck and diagnostics on a Lex document</caption>
            <image>https://lex.ing/img/flatpak/flatpak-3.png</image>
        </screenshot>
        <screenshot>
            <caption>Theme switcher UI and example theme</caption>
            <image>https://lex.ing/img/flatpak/flatpak-4.png</image>
        </screenshot>
    </screenshots>

    <releases>
		@release_info@
		<release version="0.0.0" date="1970-01-01">
			<description>
				<p>Dummy release to keep flatpak-builder AppStream metadata validation from complaining</p>
			</description>
		</release>
    </releases>
</component>
